# ===================================
# ChatterBox Environment Variables
# ===================================
# Copy this file to .env and update the values

# Database
DB_PASSWORD=your_strong_password_here

# JWT Secret (must be at least 32 characters)
JWT_SECRET=your-production-jwt-secret-key-that-is-at-least-256-bits-long

# Cloudinary (cloud file storage)
# Get your URL from: https://cloudinary.com/console → Dashboard → "API Environment variable"
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Server port (optional, default 8080)
# SERVER_PORT=8080
